# ==============================================================================
# Commercialize Grant Platform (Dana Pengkomersialan) - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT-SIDE CONFIGURATION (Vite React Frontend)
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Configuration -> API
# - Project URL: https://<project-ref>.supabase.co
# - Project API Keys: anon (public)
# NOTE: In Vite, client-exposed variables MUST start with VITE_
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key"

# ------------------------------------------------------------------------------
# 2. SUPABASE DIRECT POSTGRESQL / SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Configuration -> Database -> Connection string
# Direct Connection (Port 5432) or Transaction Pooler (Port 6543):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Transaction Pooler URL (recommended for serverless Vercel / Cloud Run):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Standard PostgreSQL connection fields (if using individual parameters):
PGHOST="db.[YOUR-PROJECT-REF].supabase.co"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="[YOUR-PASSWORD]"
PGPORT="5432"

# ------------------------------------------------------------------------------
# 3. AI STUDIO / GEMINI CONFIGURATION (Auto-injected in AI Studio Cloud Run)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
